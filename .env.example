# ============================================
# Smart Campus - Environment Variables
# ============================================
# Copy file nay thanh .env.local va dien thong tin
# cp .env.example apps/api/.env.local
# KHONG COMMIT FILE .env.local!
# ============================================

# Database
DATABASE_URL="postgresql://smartcampus:smartcampus_dev@localhost:5432/smart_campus"

# JWT Authentication
JWT_SECRET="change-this-to-a-very-long-random-secret-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=3000
CORS_ORIGIN="*"

# Firebase (Push Notifications) - se cau hinh sau
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# OpenAI (AI Chatbot) - se cau hinh sau
# OPENAI_API_KEY=""

# Redis (Cache/Queue) - se cau hinh sau
# REDIS_URL="redis://localhost:6379"
