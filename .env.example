# ============================================
# Smart Campus - Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://smartcampus:smartcampus_dev@localhost:5432/smart_campus"

# JWT Authentication
JWT_SECRET="change-this-to-a-very-long-random-secret-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=3000
CORS_ORIGIN="*"
APP_BASE_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# IoT Gateway Shared Secret
IOT_SHARED_SECRET="change-me"

# IoT MQTT Subscriber (ESP32 -> Broker -> API)
IOT_MQTT_ENABLED="false"
IOT_MQTT_BROKER_URL="mqtt://127.0.0.1:1883"
IOT_MQTT_USERNAME=""
IOT_MQTT_PASSWORD=""
IOT_MQTT_CLIENT_ID="smart-campus-api"
IOT_MQTT_TELEMETRY_TOPIC="uit/parking/telemetry"
IOT_MQTT_BRIDGE_CLIENT_ID="smart-campus-mqtt-bridge"
IOT_MQTT_BRIDGE_API_URL="http://api:3000/api/v1/iot/telemetry"

# MoMo Sandbox
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_REDIRECT_URL="http://localhost:3000/api/v1/payments/momo/return"
MOMO_IPN_URL="http://localhost:3000/api/v1/payments/momo/webhook"

# SePay QR + Webhook
SEPAY_API_TOKEN=""
SEPAY_BANK_ACCOUNT_UUID=""
SEPAY_API_BASE_URL="https://userapi.sepay.vn/v2"
SEPAY_VA_PREFIX=""
SEPAY_WEBHOOK_API_KEY=""

TRACK_ASIA_SERVER_KEY=""
TRACK_ASIA_STYLE_URL=""
OPEN_LIBRARY_USER_AGENT="UIT Smart Campus Seeder/1.0 (support@uit.edu.vn)"
EXPO_PUBLIC_TRACK_ASIA_MAP_KEY=""
EXPO_PUBLIC_TRACK_ASIA_STYLE_URL=""

# UIT Events scrape/cache
UIT_EVENTS_INITIAL_PAGES="2"
UIT_EVENTS_MAX_PAGES="10"
UIT_EVENTS_CACHE_TTL_MS="3600000"
UIT_EVENTS_REQUEST_TIMEOUT_MS="20000"

# Firebase (Push Notifications) - se cau hinh sau
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# OpenAI (AI Chatbot) - se cau hinh sau
# OPENAI_API_KEY=""

# Redis (Cache/Queue) - se cau hinh sau
# REDIS_URL="redis://localhost:6379"
