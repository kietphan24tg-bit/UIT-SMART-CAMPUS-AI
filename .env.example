APP_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_ROOT_PATH=/ai

DOCUMENTS_DIR=D:/Workspace/UIT-document-normalized
DATABASE_URL=postgresql://user:password@localhost:5432/uit_smartcampus
RAG_DB_SCHEMA=rag

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_DEVICE=
LOCAL_EMBEDDING_QUERY_PREFIX=query: 
LOCAL_EMBEDDING_DOCUMENT_PREFIX=passage: 
GEMINI_KEY=

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
GROQ_KEY=

CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_DELAY_SECONDS=0.7
GEMINI_MAX_RETRIES=8
ENABLE_SEMANTIC_CHUNKING=false

# ── Retrieval tuning ───────────────────────────────────────────────────────
# Number of raw candidates fetched before re-ranking (vector + keyword each)
RETRIEVAL_CANDIDATE_K=30
# Final chunks passed to the LLM
RAG_TOP_K=6
# Drop chunks below this retrieval/reranker score
RETRIEVAL_MIN_SCORE=0.15
# Only return chunks from current (is_current=true) documents
RETRIEVAL_FILTER_CURRENT=true

# ── Hybrid search ──────────────────────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60
HYBRID_KEYWORD_WEIGHT=1.0
HYBRID_VECTOR_WEIGHT=1.0

# ── Re-ranker (optional) ──────────────────────────────────────────────────
# Set RERANKER_ENABLED=true + install sentence-transformers to enable
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MIN_SCORE=-5.0

# ── Answer gating ─────────────────────────────────────────────────────────
# Minimum top-chunk score to call the LLM (fallback if below threshold)
ANSWER_MIN_CONFIDENCE=0.20
