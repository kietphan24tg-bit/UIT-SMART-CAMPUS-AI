# Local OTP preview is enabled only for the explicit development/test environments.
NODE_ENV="development"
# Host port 65432 matches api/nest/docker-compose.yml (postgres maps 65432:5432)
DATABASE_URL="postgresql://smartcampus:smartcampus_dev@localhost:65432/smart_campus"
JWT_SECRET="smart-campus-dev-secret"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
CORS_ORIGIN="*"
APP_BASE_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6379"
IOT_SHARED_SECRET="change-me"
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_REDIRECT_URL="http://localhost:3000/api/v1/payments/momo/return"
MOMO_IPN_URL="http://localhost:3000/api/v1/payments/momo/webhook"
SEPAY_API_TOKEN=""
SEPAY_BANK_ACCOUNT_UUID=""
SEPAY_API_BASE_URL="https://userapi.sepay.vn/v2"
SEPAY_VA_PREFIX=""
SEPAY_WEBHOOK_API_KEY=""
# Required in staging/production for registration verification and password-reset OTP.
# Preview OTP is for local development only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UIT Smart Campus <noreply@uit.edu.vn>"
AVATAR_STORAGE_BUCKET="smart-campus-assets"
AVATAR_STORAGE_ENDPOINT="http://127.0.0.1:9000"
AVATAR_STORAGE_ACCESS_KEY_ID="smartcampus"
AVATAR_STORAGE_SECRET_ACCESS_KEY="smartcampus_minio_dev"
AVATAR_STORAGE_REGION="us-east-1"
AVATAR_STORAGE_PUBLIC_BASE_URL="http://192.168.1.7:9000/smart-campus-assets"
UIT_EVENTS_MAX_PAGES="6"
UIT_EVENTS_CACHE_TTL_MS="900000"
UIT_EVENTS_REQUEST_TIMEOUT_MS="20000"
TRACK_ASIA_SERVER_KEY=""
TRACK_ASIA_STYLE_URL=""
OPEN_LIBRARY_USER_AGENT="UIT Smart Campus Seeder/1.0 (contact: support@uit.edu.vn)"

# ── AI / RAG service ────────────────────────────────────────────────────────────
# URL of the FastAPI AI service (http://localhost:8000 in local dev)
AI_SERVICE_URL="http://localhost:8000"
# Preferred service-to-service token header used by FastAPI guardrails
AI_SERVICE_TOKEN=""
# Shared secret for internal service-to-service auth (optional but recommended)
AI_INTERNAL_SECRET=""
