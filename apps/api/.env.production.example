NODE_ENV="production"
PORT="3000"

DATABASE_URL="postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>?sslmode=require"

JWT_SECRET="<replace-with-a-long-random-secret>"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
CORS_ORIGIN="https://<your-frontend-domain>"
APP_BASE_URL="https://<your-api-domain>"
REDIS_URL="redis://<host>:6379"
IOT_SHARED_SECRET="<replace-if-using-iot-gateway>"

MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_REDIRECT_URL="https://<your-api-domain>/api/v1/payments/momo/return"
MOMO_IPN_URL="https://<your-api-domain>/api/v1/payments/momo/webhook"

SEPAY_API_TOKEN="<replace-with-sepay-api-token>"
SEPAY_BANK_ACCOUNT_UUID="<replace-with-sepay-bank-account-uuid>"
SEPAY_API_BASE_URL="https://userapi.sepay.vn/v2"
SEPAY_VA_PREFIX=""
SEPAY_WEBHOOK_API_KEY="<replace-with-sepay-webhook-api-key>"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

AVATAR_STORAGE_BUCKET=""
AVATAR_STORAGE_ENDPOINT=""
AVATAR_STORAGE_ACCESS_KEY_ID=""
AVATAR_STORAGE_SECRET_ACCESS_KEY=""
AVATAR_STORAGE_REGION="us-east-1"
AVATAR_STORAGE_PUBLIC_BASE_URL=""

UIT_EVENTS_MAX_PAGES="10"
UIT_EVENTS_CACHE_TTL_MS="900000"
UIT_EVENTS_REQUEST_TIMEOUT_MS="20000"
TRACK_ASIA_SERVER_KEY=""
TRACK_ASIA_STYLE_URL=""
OPEN_LIBRARY_USER_AGENT="UIT Smart Campus Production/1.0"
