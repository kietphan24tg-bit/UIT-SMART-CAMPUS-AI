generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  lecturer
  admin
  super_admin
}

enum SubscriptionStatus {
  inactive
  pending
  active
  expired
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  expired
}

enum ParkingSessionStatus {
  active
  completed
}

enum ScheduleSessionType {
  daytime
  evening
}

enum AttendanceSessionStatus {
  active
  closed
  expired
}

enum RoomType {
  classroom
  lab
  meeting
}

enum RoomStatus {
  active
  maintenance
}

enum RoomBookingStatus {
  pending
  approved
  booked
  maintenance
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  studentId       String?   @unique @map("student_id")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  avatarUrl       String?   @map("avatar_url")
  role            Role      @default(student)
  faculty         String?
  major           String?
  yearOfAdmission Int?      @map("year_of_admission")
  phone           String?
  dateOfBirth     DateTime? @map("date_of_birth")
  address         String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens        RefreshToken[]
  passwordResetOtps    PasswordResetOtp[]
  scheduleItems        ScheduleItem[]
  grades               Grade[]
  notifications        Notification[]
  pushTokens           UserDevicePushToken[]
  attendanceSessions   AttendanceSession[]
  attendanceRecords    AttendanceRecord[]
  vehicles             Vehicle[]
  roomBookings         RoomBooking[]         @relation("RoomBookingsCreatedBy")
  approvedRoomBookings RoomBooking[]         @relation("RoomBookingsApprovedBy")

  @@map("users")
}

model Building {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  floors Floor[]

  @@map("buildings")
}

model Floor {
  id          String   @id @default(uuid())
  buildingId  String   @map("building_id")
  floorNumber Int      @map("floor_number")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([buildingId, floorNumber])
  @@map("floors")
}

model Room {
  id        String     @id @default(uuid())
  floorId   String     @map("floor_id")
  roomCode  String     @unique @map("room_code")
  name      String?
  capacity  Int
  type      RoomType
  status    RoomStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  roomBookings RoomBooking[]

  @@index([floorId, status])
  @@map("rooms")
}

model TimeSlot {
  id         String   @id @default(uuid())
  slotNumber Int      @unique @map("slot_number")
  label      String
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roomBookings RoomBooking[]

  @@map("time_slots")
}

model RoomBooking {
  id             String            @id @default(uuid())
  roomId         String            @map("room_id")
  userId         String            @map("user_id")
  bookingDate    DateTime          @map("booking_date") @db.Date
  timeSlotId     String?           @map("time_slot_id")
  startTime      String?           @map("start_time")
  endTime        String?           @map("end_time")
  title          String?
  purpose        String
  attendeeCount  Int?              @map("attendee_count")
  contactName    String?           @map("contact_name")
  contactPhone   String?           @map("contact_phone")
  departmentName String?           @map("department_name")
  status         RoomBookingStatus @default(pending)
  approvedById   String?           @map("approved_by_id")
  approvedAt     DateTime?         @map("approved_at")
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation("RoomBookingsCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("RoomBookingsApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([roomId, bookingDate, timeSlotId])
  @@index([roomId, bookingDate, status])
  @@index([userId, bookingDate])
  @@index([timeSlotId])
  @@map("room_bookings")
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_reset_otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Semester {
  id           String   @id @default(uuid())
  name         String
  academicYear String   @map("academic_year")
  term         Int      @map("term")
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  isCurrent    Boolean  @default(false) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at")

  classSections ClassSection[]
  grades        Grade[]

  @@map("semesters")
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  credits     Int
  description String?
  faculty     String?
  createdAt   DateTime @default(now()) @map("created_at")

  classSections ClassSection[]
  grades        Grade[]

  @@map("courses")
}

model ClassSection {
  id          String   @id @default(uuid())
  semesterId  String   @map("semester_id")
  courseId    String   @map("course_id")
  classCode   String   @unique @map("class_code")
  sectionCode String   @map("section_code")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  semester           Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleItems      ScheduleItem[]
  attendanceSessions AttendanceSession[]

  @@unique([semesterId, courseId, sectionCode])
  @@map("class_sections")
}

model AttendanceSession {
  id             String                  @id @default(uuid())
  classSectionId String                  @map("class_section_id")
  lecturerId     String                  @map("lecturer_id")
  status         AttendanceSessionStatus @default(active)
  startedAt      DateTime                @default(now()) @map("started_at")
  expiresAt      DateTime                @map("expires_at")
  closedAt       DateTime?               @map("closed_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  classSection ClassSection       @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  lecturer     User               @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  records      AttendanceRecord[]

  @@index([classSectionId, startedAt])
  @@index([lecturerId, status])
  @@index([status, expiresAt])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  studentId   String   @map("student_id")
  checkinTime DateTime @default(now()) @map("checkin_time")
  createdAt   DateTime @default(now()) @map("created_at")

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, checkinTime])
  @@map("attendance_records")
}

model ScheduleItem {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  classSectionId String              @map("class_section_id")
  instructor     String?
  room           String?
  dayOfWeek      Int                 @map("day_of_week")
  startTime      String              @map("start_time")
  endTime        String              @map("end_time")
  startPeriod    Int?                @map("start_period")
  endPeriod      Int?                @map("end_period")
  sessionType    ScheduleSessionType @default(daytime) @map("session_type")
  createdAt      DateTime            @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek, startTime])
  @@map("schedule_items")
}

model Grade {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  courseId      String   @map("course_id")
  semesterId    String   @map("semester_id")
  midterm       Float?
  finalExam     Float?   @map("final_exam")
  assignment    Float?
  totalScore    Float?   @map("total_score")
  letterGrade   String?  @map("letter_grade")
  gradePoint    Float?   @map("grade_point")
  isExempt      Boolean  @default(false) @map("is_exempt")
  earnedCredits Int      @default(0) @map("earned_credits")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  @@unique([userId, courseId, semesterId])
  @@map("grades")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String   @default("general")
  isRead    Boolean  @default(false) @map("is_read")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model UserDevicePushToken {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  expoPushToken String   @map("expo_push_token")
  platform      String
  deviceId      String?  @map("device_id")
  isActive      Boolean  @default(true) @map("is_active")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expoPushToken])
  @@index([userId])
  @@map("user_device_push_tokens")
}

model Vehicle {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  plateNumber String   @unique @map("plate_number")
  rfidTag     String   @unique @map("rfid_tag")
  label       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription        ParkingSubscription?
  parkingSessions     ParkingSession[]
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@map("vehicles")
}

model ParkingSubscription {
  id            String             @id @default(uuid())
  vehicleId     String             @unique @map("vehicle_id")
  monthlyFee    Int                @default(40000) @map("monthly_fee")
  status        SubscriptionStatus @default(inactive)
  startDate     DateTime?          @map("start_date")
  endDate       DateTime?          @map("end_date")
  lastPaymentAt DateTime?          @map("last_payment_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  vehicle  Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  payments PaymentTransaction[]

  @@map("parking_subscriptions")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  vehicleId       String        @map("vehicle_id")
  subscriptionId  String?       @map("subscription_id")
  provider        String
  providerOrderId String        @unique @map("provider_order_id")
  requestId       String?       @unique @map("request_id")
  amount          Int
  status          PaymentStatus @default(pending)
  checkoutUrl     String?       @map("checkout_url")
  requestPayload  Json?         @map("request_payload")
  responsePayload Json?         @map("response_payload")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  vehicle      Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  subscription ParkingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([vehicleId, status])
  @@map("payment_transactions")
}

model ParkingSession {
  id                   String               @id @default(uuid())
  vehicleId            String               @map("vehicle_id")
  gateId               String               @map("gate_id")
  status               ParkingSessionStatus @default(active)
  recognizedEntryPlate String               @map("recognized_entry_plate")
  recognizedExitPlate  String?              @map("recognized_exit_plate")
  entryTime            DateTime             @default(now()) @map("entry_time")
  exitTime             DateTime?            @map("exit_time")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, status])
  @@index([gateId, status])
  @@map("parking_sessions")
}

model ParkingSlot {
  id           String   @id @default(uuid())
  gateId       String   @map("gate_id")
  zone         String   @default("Main")
  slotNumber   String   @map("slot_number")
  isOccupied   Boolean  @default(false) @map("is_occupied")
  vehiclePlate String?  @map("vehicle_plate")
  lastUpdated  DateTime @default(now()) @map("last_updated")

  @@unique([gateId, slotNumber])
  @@index([gateId, isOccupied])
  @@map("parking_slots")
}

model TelemetrySnapshot {
  id           String   @id @default(uuid())
  gateId       String   @map("gate_id")
  deviceIp     String?  @map("device_ip")
  slotBitmap   String?  @map("slot_bitmap")
  slots        Json
  temperature  Float?
  humidity     Float?
  rainDetected Boolean  @default(false) @map("rain_detected")
  fireDetected Boolean  @default(false) @map("fire_detected")
  reportedAt   DateTime @map("reported_at")
  createdAt    DateTime @default(now()) @map("created_at")

  fireAlerts FireAlert[]

  @@index([gateId, reportedAt])
  @@map("telemetry_snapshots")
}

model FireAlert {
  id                  String    @id @default(uuid())
  gateId              String    @map("gate_id")
  telemetrySnapshotId String?   @map("telemetry_snapshot_id")
  message             String
  isResolved          Boolean   @default(false) @map("is_resolved")
  reportedAt          DateTime  @map("reported_at")
  resolvedAt          DateTime? @map("resolved_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  telemetrySnapshot TelemetrySnapshot? @relation(fields: [telemetrySnapshotId], references: [id], onDelete: SetNull)

  @@index([gateId, reportedAt])
  @@map("fire_alerts")
}
