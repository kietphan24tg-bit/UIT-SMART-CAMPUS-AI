{
  "name": "smart-campus",
  "version": "0.1.0",
  "private": true,
  "description": "UIT Smart Campus - Super App for university students",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:mobile": "turbo dev --filter=mobile",
    "android:run": "pnpm --filter mobile run android:run",
    "build": "turbo build",
    "build:api": "turbo build --filter=api",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo test",
    "test:cov": "turbo test:cov",
    "test:api": "turbo test --filter=api",
    "test:mobile": "turbo test --filter=mobile",
    "clean": "turbo clean && rimraf node_modules",
    "db:generate": "turbo db:generate --filter=api",
    "db:migrate": "turbo db:migrate --filter=api",
    "db:seed": "turbo db:seed --filter=api",
    "iot-mock": "pnpm --filter api run iot-mock",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
